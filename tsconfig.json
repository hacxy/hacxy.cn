{
  "extends": "@hacxy/tsconfig/react.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "virtual:blog-config": ["./virtual.d.ts"],
      "virtual:blog-posts": ["./virtual.d.ts"],
      "virtual:github-projects": ["./virtual.d.ts"],
      "virtual:blog-pages": ["./virtual.d.ts"]
    }
  },
  "include": ["src", "test", "virtual.d.ts", "vite.config.ts", "vitest.config.ts", "blog.config.ts"]
}
