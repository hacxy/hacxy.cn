# pi-afk 循环配置（复制为 .env 后按需修改）

# 沙箱镜像名（先构建：npx sandcastle docker build-image --image-name sandcastle:pi-afk）
SANDBOX_IMAGE=sandcastle:pi-afk

# 实现 agent 使用的模型
AGENT_MODEL=deepseek/deepseek-v4-flash

# planner/merger 使用的模型（Matt 惯例：plan 用更强的模型）
# PLANNER_MODEL=deepseek/deepseek-v4-flash

# review agent 使用的模型（默认同 AGENT_MODEL，效果差再单独升级）
# REVIEW_MODEL=deepseek/deepseek-v4-flash

# pi 推理强度：off/minimal/low/medium/high/xhigh
AGENT_THINKING=medium

# 并行处理的 issue 数
MAX_PARALLEL=2

# 迭代轮数（每轮重新 plan，消化依赖链）
MAX_ITERATIONS=5

# 完成策略：none=只留本地分支 / push=推送分支 / pr=推送并开 draft PR / merge=推送+迭代末合并 main+关 issue
DELIVERY=merge

# 跳过带这些标签的 issue（逗号分隔）
SKIP_LABELS=agent:done

# 必须：planner/merger 在沙箱里跑 gh 需要认证
# GH_TOKEN=ghp_xxx

# 沙箱隔离说明：
# - 沙箱内 pi 配置目录：.sandcastle/pi-home（自动创建，gitignore；sessions 捕获后仍回宿主 ~/.pi/agent/sessions）
# - deepseek 凭据自动从宿主 ~/.pi/agent/auth.json 读取并以 DEEPSEEK_API_KEY 注入，无需配置
# - skills 仓库内嵌于 .sandcastle/skills（不挂载宿主 ~/.pi）
