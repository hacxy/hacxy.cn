# pi-afk 基础循环配置（复制为 .env 后按需修改）

# 沙箱镜像名（先构建：docker build -t sandcastle:pi-afk .sandcastle/）
SANDBOX_IMAGE=sandcastle:pi-afk

# pi 使用的模型
AGENT_MODEL=deepseek/deepseek-v4-flash

# pi 推理强度：off/minimal/low/medium/high/xhigh
AGENT_THINKING=medium

# 并行处理的 issue 数
MAX_PARALLEL=2

# 循环轮数（每轮重新拉取 open issues）
MAX_ROUNDS=5

# 完成策略：none=只留本地分支 / push=推送分支 / pr=推送并开 draft PR
DELIVERY=pr

# 跳过带这些标签的 issue（逗号分隔）
SKIP_LABELS=agent:done
