{
  "name": "hacxy.cn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:test": "eslint test",
    "lint:e2e": "eslint e2e",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,mdx,scss,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "classnames": "^2.5.1",
    "esbuild": "^0.27.0",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.1",
    "motion": "latest",
    "react": "^19.0.0",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "sass": "^1.99.0",
    "shiki": "^4.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hacxy/eslint-config": "^0.14.0",
    "@hacxy/prettier-config": "^0.14.0",
    "@hacxy/tsconfig": "^0.14.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.4",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.10"
  }
}
